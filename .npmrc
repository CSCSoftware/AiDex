# Required: tree-sitter grammar packages declare peer deps on older tree-sitter versions
# (^0.21.x / ^0.22.x) while we use ^0.25.0. All packages use NAPI so this is ABI-safe.
# Remove when grammar packages release versions declaring tree-sitter ^0.25 as peer.
legacy-peer-deps=true

# pnpm equivalent (npm flag above is ignored by pnpm) lives in package.json under "pnpm".
# Needed for build pipelines that use pnpm (e.g. Glama's MCP-server marketplace build).
